# Required — Supabase project (Settings → API on the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — error monitoring (sentry.io). Leave unset and the app runs
# exactly as before; nothing is reported until a DSN is set.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload readable source maps on build (CI/production).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
